---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getProjects, getArticles } from '../lib/content';

const featuredProjects = (await getProjects()).filter(p => p.data.featured);
const latestArticle = (await getArticles())[0];

// Snapshot of the timeline on /work.
const roles = [
  { role: 'Consultant', org: 'Synogize', dates: 'Jul 2026 – Present' },
  { role: 'Associate Data Consultant', org: 'Synogize', dates: 'May 2025 – Jul 2026' },
  { role: 'Data Scientist Intern', org: 'eBdesk Malaysia', dates: 'Aug – Nov 2024' },
  { role: 'Research Officer', org: 'Youth for Energy Southeast Asia', dates: 'Jun 2024 – Apr 2025' },
  { role: 'Industrial Engineer Intern', org: 'Infineon Technologies', dates: 'Jul – Oct 2023' },
];
---

<BaseLayout
  title="Rafi Aqila Hidayat, Data & AI Consultant"
  description="Data & AI consultant specialising in cloud-based data engineering, scalable pipelines, and AI-powered systems. Based in Kuala Lumpur, Malaysia."
>
  <!-- ═══ HERO ═══ -->
  <section class="hero" id="hero">
    <div class="container">
      <p class="hero__eyebrow reveal">Data & AI Consultant · Kuala Lumpur, Malaysia</p>
      <h1 class="hero__name reveal">Rafi Aqila Hidayat</h1>
      <p class="hero__tagline reveal">Building data platforms and intelligent systems that create real business value</p>
      <p class="hero__bio reveal">Data consultant specialising in cloud-based data engineering and AI, with a background in Industrial Engineering. I build scalable data pipelines, clean semantic layers, and AI-powered systems that help organisations make sharper decisions and create real value for their business. Outside of work, I play tennis and am slowly getting into outdoor activities and travel.</p>
      <div class="hero__ctas reveal">
        <a href="/projects" class="btn btn--primary">
          View Projects
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
        <a href="https://linkedin.com/in/raqilhidayat" target="_blank" rel="noopener" class="btn btn--subtle">
          LinkedIn
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 12L12 4M12 4H6M12 4v6"/></svg>
        </a>
        <a href="https://github.com/rafi-hidayat" target="_blank" rel="noopener" class="btn btn--subtle">
          GitHub
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 12L12 4M12 4H6M12 4v6"/></svg>
        </a>
        <a href="https://drive.google.com/file/d/1cgTFscMaYQfGUqjzKP_QNmPbN_B8e7s2/view?usp=sharing" target="_blank" rel="noopener" class="btn btn--outline">
          Resume
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 12L12 4M12 4H6M12 4v6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ EXPERIENCE SNAPSHOT ═══ -->
  <section class="section">
    <div class="container">
      <p class="section__eyebrow reveal">Career</p>
      <div class="section__head reveal">
        <h2 class="section__title">Experience</h2>
        <a href="/work" class="btn btn--subtle btn--sm">
          Full experience
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
      </div>
      <ul class="role-list reveal">
        {roles.map(r => (
          <li class="role-list__item">
            <div>
              <p class="role-list__role">{r.role}</p>
              <p class="role-list__org">{r.org}</p>
            </div>
            <span class="role-list__dates">{r.dates}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ FEATURED PROJECTS ═══ -->
  <section class="section section--dark">
    <div class="container">
      <p class="section__eyebrow reveal">Selected work</p>
      <div class="section__head reveal">
        <h2 class="section__title">Featured projects</h2>
        <a href="/projects" class="btn btn--on-dark btn--sm">
          All projects
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
      </div>
      <div class="projects-grid reveal-stagger">
        {featuredProjects.map(project => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <!-- ═══ LATEST WRITING ═══ -->
  {latestArticle && (
    <section class="section">
      <div class="container">
        <p class="section__eyebrow reveal">Writing</p>
        <div class="section__head reveal">
          <h2 class="section__title">Latest article</h2>
          <a href="/writing" class="btn btn--subtle btn--sm">
            All writing
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </a>
        </div>
        <div class="articles-grid">
          <ArticleCard article={latestArticle} />
        </div>
      </div>
    </section>
  )}
</BaseLayout>
