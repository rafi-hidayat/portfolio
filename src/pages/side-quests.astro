---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

// Category photos live in src/assets/side-quests/<slug>.(jpg|jpeg|png|webp); a missing one shows a blank tile.
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/side-quests/*.{jpg,jpeg,png,webp}', { eager: true });
const photoFor = (slug: string) =>
  Object.entries(photos).find(([path]) => path.split('/').pop()!.replace(/\.\w+$/, '') === slug)?.[1].default;

// Placeholder until the side-quests collection lands (tennis, hiking, travel posts).
const categories = [
  { slug: 'tennis', name: 'Tennis', blurb: 'How my amateur league season is going.' },
  { slug: 'hiking', name: 'Hiking', blurb: 'Trails, photos and stories from each hike.' },
  { slug: 'travel', name: 'Travel', blurb: 'Places I have been and what I found there.' },
].map(c => ({ ...c, photo: photoFor(c.slug) }));
---

<BaseLayout
  title="Side Quests | Rafi Aqila Hidayat"
  description="What Rafi Aqila Hidayat is up to outside of work: tennis, hiking and travel."
  active="side-quests"
>
  <section class="section section--page-top">
    <div class="container">
      <p class="section__eyebrow reveal">Side Quests</p>
      <h2 class="section__title reveal">What I am up to outside of work</h2>
      <div class="quest-list reveal-stagger">
        {categories.map(c => (
          <div class="quest-row reveal">
            <div class="quest-row__photo">
              {c.photo && <Image src={c.photo} alt={c.name} widths={[400, 800]} sizes="(max-width: 768px) 100vw, 400px" />}
            </div>
            <div class="quest-row__body">
              <h3 class="quest-row__name">{c.name}</h3>
              <p class="quest-row__blurb">{c.blurb}</p>
              <p class="quest-row__note">First posts coming soon.</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
